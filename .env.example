# The chat route calls the agent service directly from the browser.
# Do NOT proxy this through Netlify — Netlify buffers responses and SSE dies.
#
# Copy to .env.local for development:
#   cp .env.example .env.local
#
# In production set VITE_AGENT_URL in Netlify's build environment to the
# Cloud Run service URL.
VITE_AGENT_URL=http://localhost:8080

# Supabase project that serves the dashboard payload and the business-plan RPCs.
# The anon/publishable key is safe in the browser bundle; every table it reaches
# is read-only for that role. Both fall back to the production project when unset.
VITE_SUPABASE_URL=https://jhsttedcvzfkszbzczak.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_oBTnHtE66ud3WBb1qRBuFQ_m64VuohI
