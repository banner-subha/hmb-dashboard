# The chat route calls the agent service directly from the browser.
# Do NOT proxy this through Netlify — Netlify buffers responses and SSE dies.
#
# Copy to .env.local for development:
#   cp .env.example .env.local
#
# In production set VITE_AGENT_URL in Netlify's build environment to the
# Cloud Run service URL.
VITE_AGENT_URL=http://localhost:8080
